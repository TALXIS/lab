{
  "name": "TALXIS Lab - Agentic Power Platform Development",
  // The image sets up the tools, Claude Code and GitHub Copilot with the TALXIS/skills plugin, and
  // brings the tools up to date on every start.
  "image": "ghcr.io/talxis/tools-agentbox/image:latest",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "customizations": {
    // The first screen LAB-GUIDE.md describes: the guide rendered on the left, Copilot Chat on the
    // right, and the specs in docs/design opening as readable pages.
    "codespaces": {
      "openFiles": ["LAB-GUIDE.md"]
    },
    "vscode": {
      "extensions": ["ms-vscode.powershell"],
      "settings": {
        "workbench.startupEditor": "none",
        "workbench.editorAssociations": {
          "**/LAB-GUIDE.md": "vscode.markdown.preview.editor",
          "**/docs/design/*.md": "vscode.markdown.preview.editor"
        },
        "workbench.secondarySideBar.defaultVisibility": "visible",
        // Let Copilot run the lab's own scripts and builds without asking each time.
        "chat.tools.terminal.autoApprove": {
          "/^(pwsh\\s+(-\\w+\\s+)*)?(\\./)?\\.lab-scripts\\//": true,
          "dotnet build": true
        },
        "terminal.integrated.defaultProfile.linux": "pwsh",
        "terminal.integrated.profiles.linux": {
          "pwsh": {
            "path": "pwsh",
            "icon": "terminal-powershell"
          }
        }
      }
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  }
}
