{
  "name": "TALXIS Lab - Agentic Power Platform Development",
  // The image sets up the tools, Claude Code and GitHub Copilot with the TALXIS/skills plugin, and
  // brings the tools up to date on every start.
  "image": "ghcr.io/talxis/tools-agentbox/image:latest",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": ["ms-vscode.powershell"],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "pwsh",
        "terminal.integrated.profiles.linux": {
          "pwsh": {
            "path": "pwsh",
            "icon": "terminal-powershell"
          }
        }
      }
    }
  },
  // 4 cores: the code app's Vite build, MSBuild, VS Code and Copilot share the machine, and on
  // 2 cores the lab crawled and a build was killed. A free account's 120 core-hours a month
  // still give about 30 hours on 4 cores.
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb"
  }
}
